# Copy to .env and fill in what you use. .env is ignored by git; never commit keys.

# Robot detection, option 1: Gemini (no GPU or detector needed; paid per run).
GEMINI_API_KEY=
# Spending cap per run in US dollars (the run stops if it would go over).
VISION_MAX_USD=5

# Match rosters from The Blue Alliance (or pass --roster-json on each run).
TBA_API_KEY=

# Optional: a local OpenAI-compatible vision-language model for bumper reads with --engine local.
LOCAL_VLM_URL=
LOCAL_VLM_MODEL=
LOCAL_VLM_KEY=
